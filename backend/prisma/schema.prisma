// ---------------------------------------------------------------------------
// BjDrive — schéma de données (PostgreSQL + PostGIS)
// ---------------------------------------------------------------------------
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ------------------------------- Rôles -------------------------------------
enum Role {
  CLIENT
  MANAGER // propriétaire/gérant d'une enseigne
  DRIVER // livreur
  SUPERADMIN // propriétaire de l'application
  STAFF // employé d'une enseigne (créé par son manager, lié à UNE enseigne)
}

// Mode de réception de la commande.
enum Fulfillment {
  DELIVERY // livraison à domicile par un livreur
  PICKUP // le client passe retirer sa commande à l'enseigne
}

enum StoreStatus {
  PENDING // en attente de vérification
  VERIFIED // vérifiée → visible des clients
  REJECTED
  SUSPENDED // suspension temporaire (réversible)
  BANNED // bloquée définitivement par le super-admin (irréversible côté interface)
}

enum VerificationMethod {
  ONSITE // visite sur place
  VIDEO // appel vidéo
}

// Statut de vérification d'un livreur (symétrique aux enseignes : bloqué tant que non vérifié).
enum DriverStatus {
  PENDING // en attente de vérification par le super-admin
  VERIFIED // vérifié → peut voir et accepter des livraisons
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING_PAYMENT // créée, en attente de paiement
  AWAITING_DRIVER // payée → en attente de prise en charge par un livreur
  AWAITING_PICKUP // acceptée par un livreur → en attente de récupération
  IN_DELIVERY // récupérée au magasin → en cours de livraison
  DELIVERED // reçue (code de réception validé)
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING // commande payée annulée → remboursement à traiter
  REFUNDED
}

enum PaymentProvider {
  KKIAPAY
  MTN_MOMO
  MOOV_MONEY
  BANK_CARD
  BANK_ACCOUNT
  CASH // paiement à la livraison (espèces collectées par le livreur)
}

// Mode de paiement choisi par le client à la commande.
enum PaymentMethod {
  KKIAPAY
  CASH
}

// Cible d'un avis laissé par le client après livraison.
enum ReviewTarget {
  DRIVER
  STORE
}

// ------------------------------- Utilisateurs -------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores          Store[]          @relation("StoreOwner")
  driverProfile   DriverProfile?
  orders          Order[]          @relation("OrderClient")
  deliveries      Delivery[]       @relation("DeliveryDriver")
  paymentAccounts PaymentAccount[]
  verifications   Store[]          @relation("StoreVerifier")
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
  payouts           Payout[]         @relation("PayoutBeneficiary")
  reviews           Review[]         @relation("ReviewAuthor")
  messages          Message[]

  // Employé (role STAFF) : rattaché à UNE enseigne, dont il gère produits et commandes.
  staffStore   Store?  @relation("StoreStaff", fields: [staffStoreId], references: [id], onDelete: SetNull)
  staffStoreId String?
}

// Jeton de rafraîchissement (rotation : un nouveau jeton révoque l'ancien).
model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // sha256 du jeton — le jeton en clair n'est jamais stocké
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Abonnement Web Push (notifications même application fermée).
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Coordonnées de versement (le manager/livreur reçoit ses paiements ici)
model PaymentAccount {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  provider  PaymentProvider
  label     String? // ex: "Mon MoMo pro"
  // numéro Mobile Money / Moov, IBAN, ou identifiant marchand KkiaPay
  accountRef String
  holderName String?
  isDefault  Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([userId])
}

// ------------------------------- Enseignes ----------------------------------
model Category {
  id     String  @id @default(cuid())
  slug   String  @unique // supermarche, hypermarche, kiosque...
  name   String
  emoji  String?
  order  Int     @default(0)
  stores Store[]
}

model Store {
  id          String      @id @default(cuid())
  owner       User        @relation("StoreOwner", fields: [ownerId], references: [id])
  ownerId     String
  name        String
  description String?
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  emoji       String?
  color       String?
  imageUrl    String? // photo de la boutique (upload local /uploads)
  address     String
  // Localisation sur la carte (lat/lng ; colonne géographique PostGIS ajoutée par apply-postgis)
  lat         Float
  lng         Float
  status      StoreStatus @default(PENDING)

  // Vérification
  verificationMethod VerificationMethod?
  verificationNotes  String?
  verifiedBy         User?               @relation("StoreVerifier", fields: [verifiedById], references: [id])
  verifiedById       String?
  verifiedAt         DateTime?

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products    Product[]
  orderStores OrderStore[]
  staff       User[]       @relation("StoreStaff")

  @@index([status])
  @@index([categoryId])
}

model Product {
  id          String   @id @default(cuid())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     String
  name        String
  description String?
  category    String? // rayon interne (Épicerie, Frais...)
  emoji       String?
  imageUrl    String? // photo du produit (upload local /uploads)
  // Code-barres INTERNE à l'enseigne (le même produit peut avoir un code
  // différent selon l'enseigne) — utilisé par le scanner des employés.
  barcode     String?
  price       Int // FCFA
  stock       Int      @default(0)
  unit        String   @default("pièce")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, barcode])
  @@index([storeId])
}

// ------------------------------- Commandes ----------------------------------
// Une commande peut porter sur PLUSIEURS enseignes (panier combiné).
model Order {
  id       String      @id @default(cuid())
  client   User        @relation("OrderClient", fields: [clientId], references: [id])
  clientId String
  status   OrderStatus @default(PENDING_PAYMENT)

  // Montants (FCFA) — commission ajoutée EN PLUS du total
  subtotal    Int // produits → réparti entre les enseignes
  deliveryFee Int // → revient au livreur (basé sur la distance de la tournée)
  commission  Int // 10% → revient à la plateforme
  total       Int // subtotal + deliveryFee + commission (payé par le client)

  // Livraison
  destLat     Float
  destLng     Float
  destAddress String?
  destNote    String?
  // Départ de la tournée (enseigne la plus éloignée du client) — pour l'affichage carte
  originLat Float?
  originLng Float?

  // Mode de paiement : KkiaPay (payé d'avance) ou espèces à la livraison
  paymentMethod PaymentMethod @default(KKIAPAY)
  // Livraison à domicile ou retrait à l'enseigne par le client
  fulfillment   Fulfillment   @default(DELIVERY)

  // Code de réception (type Uber Eats) remis au livreur à la livraison
  receptionCode String
  // Tentatives de validation du code par le livreur (anti force brute, remis à zéro par l'admin)
  codeAttempts  Int    @default(0)

  // Créneau de livraison proposé une fois la commande récupérée
  scheduledDeliveryAt DateTime?
  scheduleModified    Boolean   @default(false) // le client ne peut modifier qu'une seule fois

  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    OrderItem[]
  stores   OrderStore[]
  history  OrderStatusHistory[]
  delivery Delivery?
  payment  Payment?
  reviews  Review[]
  messages Message[]

  @@index([status])
  @@index([clientId])
}

model OrderItem {
  id        String @id @default(cuid())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  storeId   String
  storeName String
  productId String
  name      String
  emoji     String?
  price     Int
  qty       Int

  @@index([orderId])
  @@index([storeId])
}

// Une ligne par enseigne concernée par la commande (retrait + reversement).
model OrderStore {
  id           String    @id @default(cuid())
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  store        Store     @relation(fields: [storeId], references: [id])
  storeId      String
  subtotal     Int // total des produits de cette enseigne
  payoutAmount Int // reversement à l'enseigne (= subtotal)
  readyAt      DateTime? // l'enseigne a préparé/confirmé sa part de la commande
  // Chaîne de responsabilité : l'enseigne confirme AVOIR REMIS les produits au livreur.
  handedOverAt DateTime?
  pickedUpAt   DateTime? // horodatage du retrait au magasin (côté livreur)

  @@unique([orderId, storeId])
  @@index([storeId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  byUserId  String?
  at        DateTime    @default(now())

  @@index([orderId])
}

// ------------------------------- Livraisons ---------------------------------
model Delivery {
  id         String    @id @default(cuid())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String    @unique
  driver     User      @relation("DeliveryDriver", fields: [driverId], references: [id])
  driverId   String
  earnings   Int // frais de livraison qui reviennent au livreur
  acceptedAt DateTime  @default(now())
  pickedUpAt DateTime?
  deliveredAt DateTime?
  // Alerte « livraison figée » déjà traitée (suspension auto + notification admin)
  stuckNotifiedAt DateTime?

  @@index([driverId])
}

model DriverProfile {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String    @unique
  vehicle        String    @default("Zémidjan")
  isAvailable    Boolean   @default(true)
  maxPerDay      Int? // surcharge éventuelle du plafond global
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?
  createdAt      DateTime  @default(now())

  // Vérification par le super-admin (pièce d'identité, entretien...) — bloquant.
  status            DriverStatus @default(PENDING)
  verificationNotes String?
  verifiedById      String?
  verifiedAt        DateTime?

  @@index([status])
}

// ------------------------------- Paiements ----------------------------------
model Payment {
  id          String          @id @default(cuid())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String          @unique
  provider    PaymentProvider @default(KKIAPAY)
  providerRef String? // transactionId KkiaPay
  amount      Int // total payé par le client
  status      PaymentStatus   @default(PENDING)

  // Répartition
  storeAmount    Int // → enseigne
  driverAmount   Int // → livreur
  platformAmount Int // → plateforme (commission 10%)

  // Remboursement (commande payée puis annulée)
  refundRef  String? // référence du remboursement KkiaPay (ou manuel)
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Versement effectif à une enseigne ou un livreur, enregistré par le super-admin.
// Le solde dû est calculé à partir des commandes livrées moins les versements.
model Payout {
  id          String          @id @default(cuid())
  user        User            @relation("PayoutBeneficiary", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amount      Int // FCFA (peut être négatif : collecte d'espèces due par un livreur)
  provider    PaymentProvider @default(MTN_MOMO)
  reference   String? // référence de la transaction Mobile Money / virement
  note        String?
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([userId])
}

// Discussion privée d'une commande : client + personnel de l'enseigne + livreur.
model Message {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole Role // rôle au moment de l'envoi (affichage : Client / Enseigne / Livreur)
  body       String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

// Avis laissé par le client après livraison (sur le livreur et/ou chaque enseigne).
model Review {
  id         String       @id @default(cuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  author     User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  targetType ReviewTarget
  targetId   String // id du livreur (User) ou de l'enseigne (Store)
  rating     Int // 1 à 5
  comment    String?
  createdAt  DateTime     @default(now())

  @@unique([orderId, targetType, targetId])
  @@index([targetType, targetId])
}

// ------------------------- Configuration application ------------------------
model AppConfig {
  id                 Int     @id @default(1)
  baseDeliveryFee    Int     @default(500)
  perKmFee           Int     @default(100)
  commissionRate     Float   @default(0.10)
  maxDeliveriesPerDay Int    @default(5)
  allowCashOnDelivery Boolean @default(true) // autoriser le paiement à la livraison

  // ---- Anti-fraude livreurs ----
  // Un livreur devient « confirmé » après N livraisons réussies.
  trustedDriverDeliveries Int @default(20)
  // Avant d'être confirmé : valeur max d'une commande, et pas de commandes cash.
  newDriverMaxOrderTotal  Int @default(25000)
  // ---- Protection enseignes/litiges ----
  // Délai (jours) après livraison avant qu'un montant soit éligible au versement.
  payoutDelayDays         Int @default(3)

  currency           String  @default("XOF")
  updatedAt          DateTime @updatedAt
}

// Trace GPS persistée pendant une livraison (preuve en cas de litige/vol).
// Purgée automatiquement après 30 jours.
model DeliveryTrack {
  id      String   @id @default(cuid())
  orderId String
  lat     Float
  lng     Float
  at      DateTime @default(now())

  @@index([orderId, at])
  @@index([at])
}
