# === API BjDrive — variables d'environnement ===

# Base de données PostgreSQL (avec extension PostGIS)
DATABASE_URL="postgresql://bjdrive:bjdrive@localhost:5432/bjdrive?schema=public"

# Environnement : "production" active les garde-fous (paiement simulé interdit,
# webhook strict...). Laissez vide ou "development" en local.
NODE_ENV="development"

# Authentification
JWT_SECRET="changez-moi-en-production"
# Access token court — le frontend se renouvelle automatiquement via /auth/refresh
JWT_EXPIRES_IN="1h"
# Durée de vie des refresh tokens (jours)
REFRESH_EXPIRES_DAYS=30

# Super-admin créé au seed (propriétaire de l'application)
SUPERADMIN_EMAIL="admin@bjdrive.bj"
SUPERADMIN_PASSWORD="changez-moi"
SUPERADMIN_NAME="Super Admin"

# Paramètres logistiques par défaut (modifiables ensuite par le super-admin)
DEFAULT_BASE_DELIVERY_FEE=500       # frais de base (FCFA)
DEFAULT_PER_KM_FEE=100              # FCFA par km
COMMISSION_RATE=0.10               # 10% commission plateforme
MAX_DELIVERIES_PER_DAY=5           # plafond de livraisons/jour par livreur

# KkiaPay (paiement Mobile Money / Moov Money / carte)
# https://kkiapay.me — récupérez vos clés dans le tableau de bord.
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET=""
KKIAPAY_SANDBOX="true"
# Secret partagé exigé sur le webhook (configurez l'URL KkiaPay avec ?token=<secret>)
KKIAPAY_WEBHOOK_SECRET=""

# Notifications Web Push (générez les clés : npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@bjdrive.bj"

# E-mails (factures) — SMTP de votre fournisseur (ex. Brevo, Gmail app password, OVH...)
# Sans SMTP_HOST, l'envoi est désactivé (les factures sont logguées).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BjDrive <no-reply@bjdrive.bj>"

# Supervision des erreurs (facultatif — créez un projet sur sentry.io)
SENTRY_DSN=""

# Répertoire des photos uploadées (volume Docker en production)
UPLOAD_DIR="/app/uploads"

# Réseau
PORT=3007
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"
